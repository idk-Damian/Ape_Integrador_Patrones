        ADMIN([ADMIN<br/>todas las operaciones])
        VENTAS([VENTAS<br/>clientes, pedidos,<br/>validación, cobro, devoluciones])
        BODEGA([BODEGA<br/>despacho y entrega])
        CONSULTA([CONSULTA<br/>solo lectura])
    end

