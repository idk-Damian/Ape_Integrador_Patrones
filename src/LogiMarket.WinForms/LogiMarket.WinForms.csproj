<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <RootNamespace>LogiMarket.WinForms</RootNamespace>
    <ApplicationHighDpiMode>PerMonitorV2</ApplicationHighDpiMode>
    <AssemblyTitle>LogiMarket 360</AssemblyTitle>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.DependencyInjection" Version="8.0.1" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\LogiMarket.Application\LogiMarket.Application.csproj" />
    <!-- Infrastructure solo se usa en Program.cs para registrar dependencias -->
    <ProjectReference Include="..\LogiMarket.Infrastructure\LogiMarket.Infrastructure.csproj" />
    <ProjectReference Include="..\LogiMarket.Domain\LogiMarket.Domain.csproj" />
  </ItemGroup>

</Project>
